# Copy the values below into src/main/resources/application.properties
# (that file already exists with these defaults - just edit the password).

spring.datasource.url=jdbc:mysql://localhost:3306/task_assignment_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
spring.datasource.username=root
spring.datasource.password=YOUR_MYSQL_PASSWORD

spring.jpa.hibernate.ddl-auto=update
spring.jpa.open-in-view=false
spring.thymeleaf.cache=false
server.port=8080

# Business rule: max active (Pending / In Progress) tasks per employee
app.workload.max-active-tasks=5

# Load demo data on first start when the employees table is empty
app.seed-sample-data=true
